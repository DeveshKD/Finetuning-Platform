# Copy to .env and fill in.

# API key for the LLM-as-judge model, if using a hosted judge (e.g. Gemini, OpenAI).
JUDGE_MODEL_API_KEY=

# Hugging Face token, only needed for gated base models (e.g. some Gemma checkpoints).
HF_TOKEN=

# Overrides for orchestrator/resource_manager.py defaults.
MIN_FREE_VRAM_MB=2048
RESOURCE_WAIT_TIMEOUT_S=60
